# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and training runs
runs/
*.tfevents.*
best_model/
best_model (2)/
checkpoints/best_model/
checkpoints/best_model_new.pt
checkpoints/*_backup.*
export/tatvanet_new.onnx
export/*_backup.*
tatvaani_android/app/src/main/assets/*_backup.*

# Large audio data files (raw & processed audio)
data/raw/
data/processed/
*.flac
*.wav
*.mp3
*.ogg

# Explicitly track custom real dataset (tr/) and held-out benchmark (test_audio(razz)/)
!tr/
!tr/**
!test_audio(razz)/
!test_audio(razz)/**

# Temporary test exports
export/test_*.onnx
export/out.txt

# Android build outputs & local caches
tatvaani_android/app/build/
tatvaani_android/.gradle/
tatvaani_android/.kotlin/
tatvaani_android/local.properties
tatvaani_android/.idea/
.idea/
.vscode/

# OS generated files
.DS_Store
Thumbs.db
